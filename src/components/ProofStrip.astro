---
import { PROFILE, proofItems } from "../content/profile";
const items = proofItems(PROFILE);
const quote = PROFILE.clientQuote;
---
<div class="mt-6 border-t border-line pt-3">
  <ul data-testid="proof" aria-label="Credentials" class="grid grid-cols-1 gap-x-4 gap-y-1.5 text-sm sm:grid-cols-2 lg:flex lg:flex-wrap">
    {items.map((item) => (
      <li class="proof-item flex items-start gap-1">{item}</li>
    ))}
  </ul>
  {quote && (
    <figure class="mt-3 max-w-[60ch]">
      <blockquote class="text-lg">“{quote.text}”</blockquote>
      <figcaption class="mt-1 text-sm text-muted">{quote.who}</figcaption>
    </figure>
  )}
</div>

<style>
  /* A small square pad marks each credential, echoing the nav's solder pads. */
  .proof-item::before {
    content: "";
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.55em;
    border: 2px solid var(--c-accent);
    border-radius: 1px;
  }
</style>
