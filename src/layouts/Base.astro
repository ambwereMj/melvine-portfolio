---
import "../styles/global.css";
import PrefsScript from "../components/PrefsScript.astro";
import displayFont from "@fontsource/schibsted-grotesk/files/schibsted-grotesk-latin-700-normal.woff2?url";
import { absoluteUrl, ogImageFor } from "../lib/seo";
import { SITE_URL, UMAMI_WEBSITE_ID, UMAMI_SCRIPT_URL } from "../lib/site";
interface Props {
  title: string;
  description: string;
  /** Slug of the Open Graph image in public/og (default: home). */
  og?: string;
  /** "article" for case studies and notes. */
  ogType?: "website" | "article";
  jsonLd?: object;
  noindex?: boolean;
}
const { title, description, og = "home", ogType = "website", jsonLd, noindex = false } = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(ogImageFor(og));

// Headline face: preloaded, and `optional` so a late arrival never swaps in and re-wraps the LCP headline (CLS).
const displayFace = `@font-face{font-family:"Schibsted Grotesk";font-style:normal;font-weight:700;font-display:optional;src:url("${displayFont}") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <PrefsScript />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={displayFace}></style>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && (
      <>
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="Melvine Jerry" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    {UMAMI_WEBSITE_ID && (
      <script is:inline defer src={UMAMI_SCRIPT_URL} data-website-id={UMAMI_WEBSITE_ID} data-do-not-track="true" data-domains={new URL(SITE_URL).host}></script>
    )}
    <meta name="theme-color" content="#0B0F0E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F4F1EA" media="(prefers-color-scheme: light)" />
  </head>
  <body class="bg-bg text-text antialiased">
    <slot />
    <script>
      import "../scripts/analytics";
    </script>
  </body>
</html>
