---
// Terminal view inside the command palette. Its data is assembled only from approved site content.
import { getCollection } from "astro:content";
import { PROFILE, proofItems } from "../content/profile";
import { SERVICES } from "../content/services";
import { formatPrice } from "../lib/price";
import { WHATSAPP_URL, EMAIL, BOOKING_URL, TIMEZONE_LABEL } from "../lib/site";
import type { TerminalData } from "../lib/terminal";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const data: TerminalData = {
  name: "Melvine Jerry",
  oneLiner: "I build AI agents, automations and web apps.",
  proof: proofItems(PROFILE),
  timezone: TIMEZONE_LABEL,
  work: work.map((w) => ({ project: w.data.project, status: w.data.status, href: `/work/${w.id}/` })),
  services: SERVICES.map((s) => ({ name: s.name, local: formatPrice(s.price.local), international: formatPrice(s.price.international) })),
  whatsapp: WHATSAPP_URL,
  email: EMAIL,
  booking: BOOKING_URL,
};
---
<div data-view="terminal" hidden class="terminal px-2 py-1.5 font-mono text-sm">
  <p class="text-muted">Type <span class="text-accent">help</span> to see commands.</p>
  <div data-testid="terminal-output" aria-live="polite" class="mt-1 max-h-[50dvh] space-y-0.5 overflow-y-auto"></div>
  <form data-terminal-form class="mt-1 flex items-center gap-1">
    <label for="terminal-input" class="shrink-0 text-accent">melvine@portfolio:~$</label>
    <input id="terminal-input" type="text" autocomplete="off" spellcheck="false" autocapitalize="off"
      class="min-h-[44px] w-full bg-transparent text-text outline-none" />
  </form>
</div>
<script type="application/json" id="terminal-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

<script>
  import { initTerminal } from "../scripts/terminal";
  initTerminal();
</script>
