---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const btn = "inline-flex min-h-[44px] min-w-[44px] items-center gap-1 rounded-sm border border-border px-1.5 font-mono text-xs text-muted hover:text-text aria-pressed:border-accent aria-pressed:text-accent transition-colors cursor-pointer";
---
<div class="flex gap-1" role="group" aria-label="Display preferences">
  <button type="button" class={btn} data-pref="theme" aria-pressed="false" aria-label={compact ? "Light theme" : undefined}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3"/></svg>
    {!compact && <span>Light theme</span>}
  </button>
  <button type="button" class={btn} data-pref="motion" aria-pressed="false" aria-label={compact ? "Reduce motion" : undefined}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 8h3l2-5 4 10 2-5h3"/></svg>
    {!compact && <span>Reduce motion</span>}
  </button>
</div>

<script>
  import { THEME_KEY, MOTION_KEY, writeStored } from "../lib/prefs";

  const root = document.documentElement;
  const pressed = { theme: () => root.dataset.theme === "light", motion: () => root.dataset.motion === "reduce" };

  function sync() {
    document.querySelectorAll<HTMLButtonElement>("button[data-pref]").forEach((b) => {
      const key = b.dataset.pref as keyof typeof pressed;
      b.setAttribute("aria-pressed", String(pressed[key]()));
    });
  }

  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("button[data-pref]");
    if (!b) return;
    if (b.dataset.pref === "theme") {
      root.dataset.theme = root.dataset.theme === "light" ? "dark" : "light";
      writeStored(THEME_KEY, root.dataset.theme);
    } else {
      root.dataset.motion = root.dataset.motion === "reduce" ? "full" : "reduce";
      writeStored(MOTION_KEY, root.dataset.motion);
    }
    sync();
  });
  sync();
</script>
