---
import Base from "../layouts/Base.astro";
import SkipLink from "../components/SkipLink.astro";
import Sidebar from "../components/Sidebar.astro";
import MobileHeader from "../components/MobileHeader.astro";
import BottomBar from "../components/BottomBar.astro";
import Section from "../components/Section.astro";
import Cta from "../components/Cta.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { SECTIONS, WHATSAPP_URL, EMAIL } from "../lib/site";

const stageFor: Record<string, number> = { work: 3, services: 3, process: 6, about: 6, lab: 6, contact: 6 };
const rest = SECTIONS.filter((s) => s.id !== "hero");
---
<Base title="Melvine Jerry: AI agents, automations and web apps" description="Melvine Jerry builds WhatsApp AI agents, automations and web apps for businesses in Kenya and worldwide.">
  <SkipLink />
  <div class="mx-auto grid max-w-[1440px] lg:grid-cols-[minmax(320px,380px)_1fr]">
    <Sidebar />
    <div class="min-w-0">
      <MobileHeader />
      <main id="main" tabindex="-1" class="px-2 outline-none sm:px-4 lg:px-8">
        <section id="hero" aria-labelledby="hero-title" class="scroll-mt-3 border-b border-line py-8 lg:py-16">
          <h1 id="hero-title" class="max-w-[18ch] text-display tracking-tight">Your headline goes here. You pick it in Stage 2.</h1>
          <p class="mt-2 max-w-[60ch] text-lg text-muted">The supporting sentence, CTAs, availability badge and proof strip also land in Stage 2.</p>
        </section>
        {rest.map((s) => <Section id={s.id} label={s.label} stage={stageFor[s.id]} />)}
      </main>
      <footer class="flex flex-col gap-2 px-2 py-8 sm:px-4 lg:px-8">
        <p class="font-display text-lg font-bold">Have a project in mind?</p>
        <div class="flex flex-wrap gap-1.5">
          <Cta href={WHATSAPP_URL} external><WhatsAppIcon />Chat on WhatsApp</Cta>
          <Cta href={`mailto:${EMAIL}`} variant="secondary">Email me</Cta>
        </div>
        <p class="text-sm text-muted">© {new Date().getFullYear()} Melvine Jerry</p>
      </footer>
    </div>
  </div>
  <BottomBar />
</Base>
