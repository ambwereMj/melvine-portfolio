---
import SiteShell from "../layouts/SiteShell.astro";
---
<SiteShell title="Page not found | Melvine Jerry" description="This page doesn't exist." noindex>
  <section class="py-8 lg:py-16">
    <h1 class="text-2xl">Page not found</h1>
    <p class="mt-2 max-w-[50ch] text-muted">This address doesn't match any page. The link may be old or mistyped.</p>
    <a href="/" class="mt-3 inline-flex min-h-[44px] items-center font-semibold text-accent underline underline-offset-4">Go to the home page</a>
  </section>
</SiteShell>
