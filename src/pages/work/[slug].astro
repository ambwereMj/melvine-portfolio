---
import { getCollection, render, type CollectionEntry } from "astro:content";
import SiteShell from "../../layouts/SiteShell.astro";
import CircuitDiagram from "../../components/CircuitDiagram.astro";
import AudienceCtas from "../../components/AudienceCtas.astro";
import { WHATSAPP_URL, BOOKING_URL, EMAIL } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"work"> }
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const live = data.status === "Live";
const whatsapp = { label: "Chat on WhatsApp", href: WHATSAPP_URL, external: true, whatsapp: true };
---
<SiteShell title={`${data.project} case study | Melvine Jerry`} description={data.summary}>
  <article class="py-5 lg:py-12">
    <a href="/#work" class="inline-flex min-h-[44px] items-center text-sm text-muted underline decoration-border underline-offset-4 hover:text-text">Back to all work</a>

    <p class="mt-2 flex flex-wrap items-center gap-1 text-sm">
      <span class="font-semibold">{data.project}</span>
      <span class:list={[live ? "text-accent" : "text-accent2-text"]}>{data.status}</span>
    </p>
    <h1 class="mt-1 max-w-[24ch] text-2xl tracking-tight">{data.title}</h1>

    {data.result && (
      <p data-testid="result" class="mt-3 max-w-[60ch] border-l-4 border-accent pl-2 text-lg">
        <span class="block text-sm font-semibold text-muted">Result</span>{data.result}
      </p>
    )}

    <dl class="mt-4 grid max-w-[60ch] grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
      <dt class="text-muted">Role</dt><dd>{data.role}</dd>
      {data.stack.length > 0 && (<><dt class="text-muted">Built with</dt><dd>{data.stack.join(", ")}</dd></>)}
      {data.links.length > 0 && (
        <><dt class="text-muted">Links</dt>
        <dd class="flex flex-wrap gap-x-2">
          {data.links.map((l) => <a href={l.href} target="_blank" rel="noopener" class="inline-flex min-h-[44px] items-center underline decoration-border underline-offset-4 hover:text-accent">{l.label}</a>)}
        </dd></>
      )}
    </dl>

    <div class="prose mt-4 max-w-[65ch]">
      <Content />
    </div>

    {data.planned.length > 0 && (
      <section data-testid="planned" aria-labelledby="planned-title" class="mt-4 max-w-[65ch]">
        <h2 id="planned-title" class="text-lg">Planned for the agent</h2>
        <ul class="mt-1 grid gap-0.5 sm:grid-cols-2">
          {data.planned.map((p) => <li class="planned-item">{p}</li>)}
        </ul>
      </section>
    )}

    <section aria-labelledby="diagram-title" class="mt-6">
      <h2 id="diagram-title" class="text-lg">How it fits together</h2>
      <CircuitDiagram id={data.diagram} />
    </section>

    <section data-testid="cta-band" aria-labelledby="cta-title" class="mt-6 border-t border-line pt-4">
      <h2 id="cta-title" class="text-xl">Want one for your business?</h2>
      <AudienceCtas
        class="mt-2"
        local={[whatsapp, { label: "Email me", href: `mailto:${EMAIL}` }]}
        international={[{ label: "Book a 15-min call", href: BOOKING_URL }, whatsapp]}
      />
    </section>
  </article>
</SiteShell>

<style>
  .planned-item::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border: 2px dashed var(--c-accent2); border-radius: 1px; }
</style>
